# Git LFS: demo models and binary sample cubes only (data/ and checkpoints are git-ignored).
# Sample metadata (*.json) and LICENSE.md stay plain text so they are readable on GitHub.
*.onnx filter=lfs diff=lfs merge=lfs -text
web/public/samples/*.bin filter=lfs diff=lfs merge=lfs -text
app/samples/*.bin filter=lfs diff=lfs merge=lfs -text

# Normalise line endings for text
* text=auto eol=lf
*.png binary
*.gif binary
*.wasm binary
